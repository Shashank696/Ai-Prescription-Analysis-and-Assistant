# Local Ollama configuration. These values are safe non-secret defaults.
OLLAMA_URL=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=128
OLLAMA_MAX_IMAGE_DIMENSION=1920
OLLAMA_NUM_GPU=0

# Local RAG answer-generation limits.
OLLAMA_RAG_TIMEOUT_SECONDS=60
OLLAMA_RAG_NUM_PREDICT=256

# Optional legacy hosted provider credential. Leave unset for local Ollama use.
# HF_TOKEN=
